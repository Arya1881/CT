# ============================================================
# CampusTransit — Environment configuration
# Copy to the relevant .env file and adjust.
#   backend/.env        -> backend server configuration
#   frontend/.env       -> frontend build-time configuration
# ============================================================

# --- Backend (.env) -------------------------------------------
PORT=4000
NODE_ENV=development

# Database: leave DATABASE_URL empty to run on the built-in
# in-memory store (perfect for the hackathon demo, zero setup).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/campustransit

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Realtime GPS simulation tick interval (milliseconds)
SIMULATION_TICK_MS=3000

# Seed / demo accounts get created automatically on first boot
SEED_DEMO=true

# --- Frontend (.env) ------------------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Optional: real Google Maps. If omitted the app renders an
# offline schematic SVG map — no network key required.
VITE_GOOGLE_MAPS_API_KEY=
